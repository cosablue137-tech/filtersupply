{%- comment -%} Filter Supply — brand band (cream) {%- endcomment -%}
<section class="band">
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {%- if section.settings.logo != blank -%}
    <div class="band__name"><img src="{{ section.settings.logo | image_url: width: 600 }}" alt="{{ shop.name }}" style="height:clamp(26px,3.4vw,44px);width:auto;display:inline-block;"></div>
  {%- else -%}
    <div class="band__name"><img src="{{ 'logo-ink.png' | asset_url }}" alt="{{ shop.name }}" style="height:clamp(26px,3.4vw,44px);width:auto;display:inline-block;"></div>
  {%- endif -%}
  {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "ブランドバンド",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "ラベル", "default": "Roasted in Fukuoka · Takasago" },
    { "type": "image_picker", "id": "logo", "label": "ロゴ（黒・透過PNG／未指定ならテーマのロゴ）" },
    { "type": "textarea", "id": "body", "label": "本文（空欄でロゴのみ）", "default": "" }
  ],
  "presets": [{ "name": "ブランドバンド" }]
}
{% endschema %}
