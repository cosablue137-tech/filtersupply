{%- comment -%} Filter Supply — newsletter {%- endcomment -%}
<section class="news">
  <h2 class="news__title">{{ section.settings.heading | default: 'Join the Mailing List' }}</h2>
  {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
  {%- form 'customer', class: 'news__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}
      <p style="width:100%;text-align:center;">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <input type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" required>
      <button type="submit">{{ 'newsletter.subscribe' | t }}</button>
    {%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{
  "name": "ニュースレター",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "Join the Mailing List" },
    { "type": "textarea", "id": "body", "label": "本文", "default": "新しい焙煎や入荷のお知らせを、ときどき。" }
  ],
  "presets": [{ "name": "ニュースレター" }]
}
{% endschema %}
