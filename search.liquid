{%- comment -%} Filter Supply — search {%- endcomment -%}
<main class="wrap" style="padding:clamp(48px,6vw,90px) 0 clamp(56px,7vw,100px);">
  <div class="sec-head"><h1 class="h-serif" style="font-size:clamp(2rem,3.4vw,2.8rem);">{{ 'search.title' | t }}</h1></div>

  <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;max-width:460px;margin:0 auto 56px;border-bottom:1px solid var(--ink);">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" style="flex:1;border:none;background:none;font-family:var(--sans);font-weight:300;font-size:14px;padding:12px 4px;outline:none;">
    <button type="submit" aria-label="{{ 'general.search' | t }}" style="padding:0 8px;">{% render 'icon', name: 'search', size: 17 %}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="serif" style="text-align:center;font-size:1.3rem;">{{ 'search.no_results' | t }}</p>
    {%- else -%}
      <p class="eyebrow" style="text-align:center;margin-bottom:44px;">{{ 'search.results_for' | t: terms: search.terms }} · {{ search.results_count }}</p>
      <div class="pgrid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</main>
