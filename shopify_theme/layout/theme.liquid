<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ffffff">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.page' | t }} {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

    {%- assign meta_desc = page_description | default: shop.description -%}
    {%- if meta_desc != blank -%}<meta name="description" content="{{ meta_desc | escape }}">{%- endif -%}

    <!-- Open Graph / SNS シェア -->
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    {%- assign og_desc = page_description | default: shop.description -%}
    {%- if og_desc != blank -%}
      <meta property="og:description" content="{{ og_desc | escape }}">
      <meta name="twitter:description" content="{{ og_desc | escape }}">
    {%- endif -%}
    {%- if template.name == 'product' -%}
      <meta property="og:type" content="product">
      {%- if product.featured_image -%}
        <meta property="og:image" content="{{ product.featured_image | image_url: width: 1200 }}">
        <meta property="og:image:width" content="1200">
      {%- endif -%}
    {%- elsif template.name == 'article' -%}
      <meta property="og:type" content="article">
      {%- if article.image -%}<meta property="og:image" content="{{ article.image | image_url: width: 1200 }}">{%- endif -%}
    {%- elsif template.name == 'collection' and collection.image -%}
      <meta property="og:type" content="website">
      <meta property="og:image" content="{{ collection.image | image_url: width: 1200 }}">
    {%- else -%}
      <meta property="og:type" content="website">
      {%- if settings.share_image != blank -%}<meta property="og:image" content="{{ settings.share_image | image_url: width: 1200 }}">{%- endif -%}
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | escape }}">
    {%- if template.name == 'product' and product.featured_image -%}<meta name="twitter:image" content="{{ product.featured_image | image_url: width: 1200 }}">
    {%- elsif settings.share_image != blank -%}<meta name="twitter:image" content="{{ settings.share_image | image_url: width: 1200 }}">{%- endif -%}

    <!-- Google Fonts — preconnect ＋ 非ブロッキング読込（描画をブロックしない） -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- assign font_href = 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400;500&family=Noto+Serif+JP:wght@400&display=swap' -%}
    <link rel="preload" as="style" href="{{ font_href }}">
    <link rel="stylesheet" href="{{ font_href }}" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="{{ font_href }}"></noscript>

    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <!-- 構造化データ：サイト全体 -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | append: '/' | json }}
      {%- if settings.share_image != blank -%},"logo": {{ settings.share_image | image_url: width: 600 | prepend: 'https:' | json }}{%- endif -%}
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | append: '/' | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }},
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    <script>
      window.Shopify = window.Shopify || {};
      window.Shopify.routes = window.Shopify.routes || {};
      window.Shopify.routes.root = "{{ routes.root_url }}{% if routes.root_url != '/' %}/{% endif %}";
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t | default: 'メインコンテンツへ移動' }}</a>
    {% section 'announcement' %}
    {% section 'header' %}
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
  </body>
</html>
