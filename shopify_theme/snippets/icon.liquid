{%- comment -%}
  Filter Supply — line icon. {% render 'icon', name: 'cart', size: 18 %}
{%- endcomment -%}
{%- liquid
  assign size = size | default: 18
-%}
<svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><line x1="16" y1="16" x2="21" y2="21"/>
    {%- when 'menu' -%}<line x1="3" y1="8" x2="21" y2="8"/><line x1="3" y1="16" x2="21" y2="16"/>
    {%- when 'close' -%}<line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/>
    {%- when 'chevron' -%}<polyline points="6,9 12,15 18,9"/>
    {%- when 'grid' -%}<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
    {%- when 'list' -%}<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
    {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.7" fill="currentColor" stroke="none"/>
    {%- when 'x' -%}<path d="M4 4 L20 20 M20 4 L4 20"/>
    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11 V8 a4 4 0 0 1 8 0 v3"/>
    {%- when 'truck' -%}<rect x="1" y="6" width="13" height="11"/><path d="M14 9 h4 l3 3 v5 h-7 z"/><circle cx="6" cy="18.5" r="1.6"/><circle cx="17" cy="18.5" r="1.6"/>
    {%- when 'leaf' -%}<path d="M4 20 C4 10 12 4 20 4 C20 12 14 20 4 20 Z"/><line x1="4" y1="20" x2="13" y2="11"/>
    {%- when 'pin' -%}<path d="M12 21 C7 15 5 11 5 8 a7 7 0 0 1 14 0 c0 3-2 7-7 13 Z"/><circle cx="12" cy="8" r="2.5"/>
  {%- endcase -%}
</svg>
