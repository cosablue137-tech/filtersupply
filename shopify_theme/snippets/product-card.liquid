{%- comment -%}
  Filter Supply — product card (Beyond style).
  Optional metafields: custom.notes (text), custom.tag (text), custom.kanji (text).
{%- endcomment -%}
{%- liquid
  assign tag = product.metafields.custom.tag
  assign kanji = product.metafields.custom.kanji | default: '豆'
  # 商品名を「英字の豆名」と「焙煎度＋容器」に2分割（焙煎度キーワードで区切る）
  assign title_main = product.title
  assign title_sub = ''
  assign roasts = '中深煎り,中浅煎り,浅煎り,中煎り,深煎り' | split: ','
  for r in roasts
    if product.title contains r
      assign sp = product.title | split: r
      assign title_main = sp[0] | strip
      assign sub_rest = sp[1] | default: '' | strip
      assign title_sub = r
      if sub_rest != ''
        assign title_sub = r | append: ' ' | append: sub_rest
      endif
      break
    endif
  endfor
-%}
<article class="pcard">
  <a class="pcard__media" href="{{ product.url }}">
    {%- if tag != blank -%}<span class="pcard__tag">{{ tag }}</span>{%- endif -%}
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 700 }}"
        srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                {{ product.featured_image | image_url: width: 700 }} 700w,
                {{ product.featured_image | image_url: width: 1000 }} 1000w"
        sizes="(max-width: 640px) 50vw, (max-width: 980px) 33vw, 25vw"
        alt="{{ product.title | escape }}"
        loading="lazy"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}">
    {%- else -%}
      <span style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-family:var(--jp);font-size:48px;color:#e4e0d8;">{{ kanji }}</span>
    {%- endif -%}
    {%- comment -%} ホバー時に中央へフェード（デスクトップ）。モバイルは下の pcard__below を常時表示 {%- endcomment -%}
    <div class="pcard__overlay" aria-hidden="true">
      <span class="pcard__overlay-name">{{ title_main }}</span>
      {%- if title_sub != blank -%}<span class="pcard__overlay-sub">{{ title_sub }}</span>{%- endif -%}
      <span class="pcard__overlay-price">{{ product.price | money }}</span>
    </div>
  </a>

  {%- if product.available -%}
    <form method="post" action="{{ routes.cart_add_url }}" class="pcard__addform">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button class="pcard__add" type="submit" aria-label="{{ 'product.add_to_cart' | t }}">+</button>
    </form>
  {%- endif -%}

  {%- comment -%} モバイル（タッチ）では名前・価格を常時表示。デスクトップでは非表示でホバー表示に切替 {%- endcomment -%}
  <a class="pcard__below" href="{{ product.url }}">
    <h3 class="pcard__name">{{ title_main }}</h3>
    {%- if title_sub != blank -%}<span class="pcard__sub">{{ title_sub }}</span>{%- endif -%}
    <p class="pcard__price">{{ product.price | money }}</p>
  </a>
</article>
