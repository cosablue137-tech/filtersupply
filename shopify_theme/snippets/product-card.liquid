{%- comment -%}
  Filter Supply — product card (Beyond style).
  Optional metafields: custom.notes (text), custom.tag (text), custom.kanji (text).
{%- endcomment -%}
{%- liquid
  assign notes = product.metafields.custom.notes
  assign tag = product.metafields.custom.tag
  assign kanji = product.metafields.custom.kanji | default: '豆'
-%}
<article class="pcard">
  <a class="pcard__media" href="{{ product.url }}">
    {%- if tag != blank -%}<span class="pcard__tag">{{ tag }}</span>{%- endif -%}
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">
    {%- else -%}
      <span style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-family:var(--jp);font-size:48px;color:#e4e0d8;">{{ kanji }}</span>
    {%- endif -%}
  </a>

  {%- if product.available -%}
    <form method="post" action="{{ routes.cart_add_url }}" class="pcard__addform">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button class="pcard__add" type="submit" aria-label="{{ 'product.add_to_cart' | t }}">+</button>
    </form>
  {%- endif -%}

  <a href="{{ product.url }}"><h3 class="pcard__name">{{ product.title }}</h3></a>
  <p class="pcard__price">{{ product.price | money }}{% if notes != blank %} · {{ notes }}{% endif %}</p>
</article>
