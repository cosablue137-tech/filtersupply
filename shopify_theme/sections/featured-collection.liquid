{%- comment -%} Filter Supply — product grid (best sellers / seasonal) {%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.count | default: 6
  assign has_products = false
  if collection != blank and collection.products.size > 0
    assign has_products = true
  endif
-%}
{%- comment -%} 商品が無いときは本番では非表示（崩れたダミーを出さない）。エディタでは設定を促す {%- endcomment -%}
{%- if has_products or request.design_mode -%}
<section class="wrap fade" style="padding:clamp(56px,7vw,100px) 0;">
  <div class="sec-head">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="sec-title" style="margin-top:8px;">{{ section.settings.heading }}</h2>
  </div>

  {%- if has_products -%}
    <div class="pgrid pgrid--scroll">
      {%- for product in collection.products limit: limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <div style="text-align:center;margin-top:clamp(40px,5vw,60px);"><a class="ulink" href="{{ collection.url }}">{{ section.settings.link_label }}</a></div>
    {%- endif -%}
  {%- elsif request.design_mode -%}
    <p style="text-align:center;color:var(--muted);padding:clamp(32px,5vw,64px) 0;">「コレクション」を選択すると、ここに商品が表示されます。</p>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "商品グリッド",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "ラベル", "default": "よく選ばれています" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "コレクション" },
    { "type": "range", "id": "count", "label": "表示点数", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "text", "id": "link_label", "label": "下部リンク文言", "default": "View Collection" }
  ],
  "presets": [{ "name": "商品グリッド" }]
}
{% endschema %}
