{%- comment -%} Filter Supply — product grid (best sellers / seasonal) {%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.count | default: 6
-%}
<section class="wrap fade" style="padding:clamp(56px,7vw,100px) 0;">
  <div class="sec-head">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="sec-title" style="margin-top:8px;">{{ section.settings.heading }}</h2>
  </div>

  <div class="pgrid">
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- for product in collection.products limit: limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <article class="pcard"><a class="pcard__media"><span style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-family:var(--jp);font-size:48px;color:#e4e0d8;">豆</span></a><h3 class="pcard__name">商品名</h3><p class="pcard__price">¥0</p></article>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.link_label != blank and collection != blank -%}
    <div style="text-align:center;margin-top:clamp(40px,5vw,60px);"><a class="ulink" href="{{ collection.url }}">{{ section.settings.link_label }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "商品グリッド",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "ラベル", "default": "よく選ばれています" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "コレクション" },
    { "type": "range", "id": "count", "label": "表示点数", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "text", "id": "link_label", "label": "下部リンク文言", "default": "View Collection" }
  ],
  "presets": [{ "name": "商品グリッド" }]
}
{% endschema %}
