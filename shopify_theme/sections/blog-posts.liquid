{%- comment -%} Filter Supply — blog posts {%- endcomment -%}
{%- liquid
  assign blog = blogs[section.settings.blog]
-%}
<section class="wrap fade" style="padding:clamp(40px,5vw,72px) 0 clamp(60px,8vw,110px);">
  <div class="sec-head">
    <span class="eyebrow">{{ section.settings.heading | default: 'Journal' }}</span>
  </div>
  <div class="blog__grid">
    {%- if blog != blank and blog.articles_count > 0 -%}
      {%- for article in blog.articles limit: 3 -%}
        <article class="bpost">
          <a class="bpost__media" href="{{ article.url }}">
            {%- if article.image -%}<img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" loading="lazy">{%- endif -%}
          </a>
          <p class="bpost__date">{{ article.published_at | date: '%Y.%m' }}</p>
          <h3 class="bpost__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <a class="ulink" href="{{ article.url }}">Read More</a>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <article class="bpost">
          <div class="bpost__media"></div>
          <p class="bpost__date">2025.01</p>
          <h3 class="bpost__title">記事タイトル</h3>
          <a class="ulink" href="#">Read More</a>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ジャーナル",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "Journal" },
    { "type": "blog", "id": "blog", "label": "ブログ" }
  ],
  "presets": [{ "name": "ジャーナル" }]
}
{% endschema %}
