{%- comment -%} Filter Supply — collection (Shop All) {%- endcomment -%}
<section class="chero">
  {%- if collection.image -%}<img src="{{ collection.image | image_url: width: 2000 }}" alt="" loading="eager" fetchpriority="high" width="{{ collection.image.width }}" height="{{ collection.image.height }}">
  {%- elsif section.settings.fallback_image != blank -%}<img src="{{ section.settings.fallback_image | image_url: width: 2000 }}" alt="" loading="eager" fetchpriority="high" width="{{ section.settings.fallback_image.width }}" height="{{ section.settings.fallback_image.height }}">{%- endif -%}
  <h1>{{ collection.title | default: 'Shop All' }}</h1>
</section>

<div class="filterbar">
  <div class="filterbar__left">
    <span class="filterbar__count">{{ collection.products_count }} 点</span>
  </div>
  <form method="get" class="filterbar__sort">
    {%- assign cur_sort = collection.sort_by | default: collection.default_sort_by -%}
    <label for="SortBy" class="filterbar__sort-label">並び替え</label>
    <select id="SortBy" name="sort_by" class="filterbar__sort-select" onchange="this.form.submit()">
      {%- for option in collection.sort_options -%}
        <option value="{{ option.value }}"{% if option.value == cur_sort %} selected{% endif %}>{{ option.name }}</option>
      {%- endfor -%}
    </select>
  </form>
</div>

<section class="wrap" style="padding:clamp(40px,5vw,72px) 0;">
  {%- paginate collection.products by 48 -%}
    {%- comment -%} プロモタイル（設定時のみ）を一度だけ定義 {%- endcomment -%}
    {%- capture promo_tile -%}
      {%- if section.settings.promo_image != blank -%}
        <a class="ptile" href="{{ section.settings.promo_link | default: routes.all_products_collection_url }}">
          <img src="{{ section.settings.promo_image | image_url: width: 800 }}" alt="" loading="lazy" width="{{ section.settings.promo_image.width }}" height="{{ section.settings.promo_image.height }}">
          <div class="ptile__in">
            <span class="eyebrow">{{ section.settings.promo_eyebrow }}</span>
            <h3 class="h-serif">{{ section.settings.promo_heading }}</h3>
            <span class="ulink" style="color:#fff">{{ section.settings.promo_link_label }}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endcapture -%}
    {%- comment -%} 豆の並び順（先頭から優先）。ETHIOPIA は GERA/SHANTAWANE を区別 {%- endcomment -%}
    {%- assign bean_order = 'PERU,HONDURAS,ETHIOPIA GERA,ETHIOPIA SHANTAWANE,DEEP TIME,BRAZIL' | split: ',' -%}
    <div class="pgrid">
      {%- if collection.products.size > 0 -%}
        {%- assign rendered = '|' -%}
        {%- assign idx = 0 -%}
        {%- comment -%} ① 瓶（豆順） {%- endcomment -%}
        {%- for bean in bean_order -%}
          {%- for product in collection.products -%}
            {%- if product.title contains '瓶' and product.title contains bean -%}
              {%- assign pid = '|' | append: product.id | append: '|' -%}
              {%- unless rendered contains pid -%}
                {% render 'product-card', product: product %}
                {%- assign rendered = rendered | append: product.id | append: '|' -%}
                {%- assign idx = idx | plus: 1 -%}{%- if idx == 3 -%}{{ promo_tile }}{%- endif -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- comment -%} ② 袋・リフィル（豆順） {%- endcomment -%}
        {%- for bean in bean_order -%}
          {%- for product in collection.products -%}
            {%- unless product.title contains '瓶' -%}
              {%- if product.title contains bean -%}
                {%- assign pid = '|' | append: product.id | append: '|' -%}
                {%- unless rendered contains pid -%}
                  {% render 'product-card', product: product %}
                  {%- assign rendered = rendered | append: product.id | append: '|' -%}
                  {%- assign idx = idx | plus: 1 -%}{%- if idx == 3 -%}{{ promo_tile }}{%- endif -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- comment -%} ③ 取りこぼし救済：瓶→袋の順で、未表示の商品 {%- endcomment -%}
        {%- for product in collection.products -%}
          {%- if product.title contains '瓶' -%}
            {%- assign pid = '|' | append: product.id | append: '|' -%}
            {%- unless rendered contains pid -%}{% render 'product-card', product: product %}{%- assign rendered = rendered | append: product.id | append: '|' -%}{%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for product in collection.products -%}
          {%- assign pid = '|' | append: product.id | append: '|' -%}
          {%- unless rendered contains pid -%}{% render 'product-card', product: product %}{%- assign rendered = rendered | append: product.id | append: '|' -%}{%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        <p class="serif" style="font-size:1.4rem;">{{ 'collection.empty' | t }}</p>
      {%- endif -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav style="margin-top:64px;display:flex;gap:20px;justify-content:center;">
        {%- if paginate.previous -%}<a class="ulink" href="{{ paginate.previous.url }}">← {{ 'general.previous' | t }}</a>{%- endif -%}
        {%- if paginate.next -%}<a class="ulink" href="{{ paginate.next.url }}">{{ 'general.next' | t }} →</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "コレクション",
  "settings": [
    { "type": "image_picker", "id": "fallback_image", "label": "ヘッダー代替画像（コレクション画像が無い時）" },
    { "type": "header", "content": "プロモタイル（4番目に挿入）" },
    { "type": "image_picker", "id": "promo_image", "label": "プロモ画像" },
    { "type": "text", "id": "promo_eyebrow", "label": "ラベル", "default": "Best Sellers" },
    { "type": "text", "id": "promo_heading", "label": "見出し", "default": "Trendy" },
    { "type": "text", "id": "promo_link_label", "label": "リンク文言", "default": "See What’s Popular" },
    { "type": "url", "id": "promo_link", "label": "リンク" }
  ]
}
{% endschema %}
