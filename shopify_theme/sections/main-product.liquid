{%- comment -%}
  Filter Supply — product page.
  Optional metafields: custom.notes, custom.origin, custom.process,
  custom.roast, custom.weight, custom.brew, custom.kanji (all text).
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.custom
  assign v = product.selected_or_first_available_variant
  # 商品名を「豆名 / 焙煎度 / パッケージ名」の3つに分割（焙煎度キーワードで区切る）
  assign t_main = product.title
  assign t_roast = ''
  assign t_pkg = ''
  assign roasts = '中深煎り,中浅煎り,浅煎り,中煎り,深煎り' | split: ','
  for r in roasts
    if product.title contains r
      assign sp = product.title | split: r
      assign t_main = sp[0] | strip
      assign t_roast = r
      assign t_pkg = sp[1] | default: '' | strip
      break
    endif
  endfor
-%}
<section class="wrap" style="padding:clamp(28px,4vw,56px) 0 clamp(56px,7vw,100px);">
  <a class="ulink" href="{{ collection.url | default: routes.all_products_collection_url }}" style="display:inline-block;margin-bottom:clamp(24px,3vw,44px);">← {{ 'product.back' | t }}</a>

  <div class="fprod" style="padding:0;">
    <div class="fprod__media">
      <div class="fprod__thumbs">
        {%- for image in product.images limit: 3 -%}
          <div class="fprod__thumb">
            <img
              src="{{ image | image_url: width: 240 }}"
              srcset="{{ image | image_url: width: 120 }} 120w, {{ image | image_url: width: 240 }} 240w, {{ image | image_url: width: 480 }} 480w"
              sizes="64px"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}">
          </div>
        {%- endfor -%}
      </div>
      <div class="fprod__main">
        {%- if product.featured_image -%}
          <img
            src="{{ product.featured_image | image_url: width: 1000 }}"
            srcset="{{ product.featured_image | image_url: width: 600 }} 600w,
                    {{ product.featured_image | image_url: width: 1000 }} 1000w,
                    {{ product.featured_image | image_url: width: 1400 }} 1400w"
            sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 40vw"
            alt="{{ product.title | escape }}"
            loading="eager"
            data-zoom="{{ product.featured_image | image_url: width: 1800 }}"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}">
        {%- else -%}
          <span style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-family:var(--jp);font-size:80px;color:#e4e0d8;">{{ m.kanji | default: '豆' }}</span>
        {%- endif -%}
      </div>
    </div>

    <div class="fprod__info">
      {%- if m.origin != blank -%}<span class="eyebrow">{{ m.origin }}</span>{%- endif -%}
      <h2 class="fprod__title">{{ t_main }}
        {%- if t_roast != blank -%}<span class="fprod__title-sub">{{ t_roast }}</span>{%- endif -%}
        {%- if t_pkg != blank -%}<span class="fprod__title-pkg">{{ t_pkg }}</span>{%- endif -%}
      </h2>
      {%- if m.notes != blank -%}<p class="eyebrow" style="margin:-6px 0 14px;color:var(--muted);">{{ m.notes }}</p>{%- endif -%}
      <p class="fprod__price" data-price>{{ v.price | money }}</p>
      {%- if v.inventory_management != blank and v.inventory_policy == 'deny' and v.inventory_quantity > 0 and v.inventory_quantity <= 5 -%}
        <p class="fprod__stock" data-low-stock>{% render 'icon', name: 'leaf', size: 12 %} 残りわずか（あと{{ v.inventory_quantity }}点）</p>
      {%- endif -%}

      {% form 'product', product, data-product-form: 'true' %}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign oname = option.name
              if option.name == 'Grind Option' or option.name == '挽目'
                assign oname = '挽き方'
              elsif option.name == 'Net Weight' or option.name == '重量'
                assign oname = '内容量'
              endif
              # 挽き方の表示順を固定：豆のまま→中挽き→粗挽き→細挽き（日本語/英語どちらの値でも対応）
              assign grind_keys = '豆のまま,Whole Bean,中挽き,Medium,粗挽き,Coarse,細挽き,Fine' | split: ','
              assign ordered = ''
              for key in grind_keys
                for value in option.values
                  if value contains key
                    unless ordered contains value
                      assign ordered = ordered | append: value | append: '~~'
                    endunless
                  endif
                endfor
              endfor
              for value in option.values
                unless ordered contains value
                  assign ordered = ordered | append: value | append: '~~'
                endunless
              endfor
              assign ordered_values = ordered | split: '~~'
              # 挽き方オプションを判定し、その場合は先頭（豆のまま）を初期選択に
              assign is_grind = false
              for value in option.values
                if value contains '挽き' or value contains '豆のまま' or value contains 'Whole Bean' or value contains 'Ground'
                  assign is_grind = true
                  break
                endif
              endfor
              assign opt_default = option.selected_value
              if is_grind
                assign opt_default = ordered_values.first
              endif
            -%}
            <div style="margin-bottom:18px;" data-option-index="{{ forloop.index0 }}">
              <div class="eyebrow" style="margin-bottom:10px;">{{ oname }}</div>
              <div style="display:flex;gap:10px;flex-wrap:wrap;">
                {%- for value in ordered_values -%}
                  {%- liquid
                    assign vdisp = value
                    case value
                      when 'Whole Bean'
                        assign vdisp = '豆のまま'
                      when 'Ground (Medium / Drip)'
                        assign vdisp = '中挽き（ドリップ用など）'
                      when 'Ground (Coarse / French Press)'
                        assign vdisp = '粗挽き（フレンチプレスなど）'
                      when 'Ground (Fine / Espresso)'
                        assign vdisp = '細挽き（エスプレッソなど）'
                    endcase
                  -%}
                  <button type="button" class="sf-chip{% if opt_default == value %} is-active{% endif %}" data-value="{{ value | escape }}" aria-pressed="{% if opt_default == value %}true{% else %}false{% endif %}"
                    style="font-family:var(--sans);font-size:11px;letter-spacing:var(--track-sm);text-transform:uppercase;padding:10px 16px;border:1px solid {% if opt_default == value %}var(--ink){% else %}var(--line-2){% endif %};background:{% if opt_default == value %}var(--ink){% else %}transparent{% endif %};color:{% if opt_default == value %}#fff{% else %}var(--ink){% endif %};">{{ vdisp }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ v.id }}">

        {%- if product.selling_plan_groups.size > 0 -%}
          <div class="ptype" data-purchase-type style="margin:4px 0 18px;">
            <div class="eyebrow" style="margin-bottom:10px;">{{ 'product.purchase_type' | t | default: '購入タイプ' }}</div>
            <label class="ptype-opt is-active">
              <input type="radio" name="purchase_type" value="onetime" checked>
              <span class="ptype-opt__label">{{ 'product.one_time' | t | default: '1回のみ購入' }}</span>
            </label>
            {%- for group in product.selling_plan_groups -%}
              {%- for plan in group.selling_plans -%}
                <label class="ptype-opt">
                  <input type="radio" name="purchase_type" value="sub" data-selling-plan="{{ plan.id }}">
                  <span class="ptype-opt__label">{{ plan.name }}</span>
                </label>
              {%- endfor -%}
            {%- endfor -%}
          </div>
          <input type="hidden" name="selling_plan" value="" data-selling-plan-input>
        {%- endif -%}

        <div class="fprod__buy" style="margin-top:24px;">
          <div style="display:flex;gap:12px;">
            <div class="qstep" data-stepper>
              <button type="button" data-step="-1" aria-label="−">−</button>
              <input type="text" name="quantity" value="1" readonly>
              <button type="button" data-step="1" aria-label="+">+</button>
            </div>
            <button class="btn btn--block" type="submit" data-add-to-cart
              data-label-add="{{ 'product.add_to_cart' | t }}" data-label-sold="{{ 'product.sold_out' | t }}"
              {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
            </button>
          </div>
          {%- if product.available -%}<button class="btn btn--ghost btn--block" type="submit" name="checkout">{{ 'product.buy_now' | t }}</button>{%- endif -%}
        </div>
      {% endform %}

      <p class="secure-note">{% render 'icon', name: 'lock', size: 12 %} {{ 'product.secure' | t | default: 'SSL暗号化による安全なお支払い' }}</p>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="secure-pay">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'icon-pay' }}{%- endfor -%}</div>
      {%- endif -%}

      <div class="fprod__acc">
        {%- if m.origin != blank or m.process != blank or m.roast != blank or m.weight != blank -%}
          <details class="acc-item"><summary>{{ 'product.details' | t }} <span class="pm">+</span></summary><div class="acc-item__body">
            {%- if m.origin != blank -%}原産地：{{ m.origin }}<br>{%- endif -%}
            {%- if m.process != blank -%}精製：{{ m.process }}<br>{%- endif -%}
            {%- if m.roast != blank -%}焙煎度：{{ m.roast }}<br>{%- endif -%}
            {%- if m.weight != blank -%}内容量：{{ m.weight }}{%- endif -%}
          </div></details>
        {%- endif -%}
        {%- if m.brew != blank -%}
          <details class="acc-item"><summary>{{ 'product.brewing' | t }} <span class="pm">+</span></summary><div class="acc-item__body">{{ m.brew }}</div></details>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if product.description != blank -%}
    <div class="prod-desc rte fade">{{ product.description }}</div>
  {%- endif -%}

  <script type="application/json" id="fs-variants-json">
    [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "options": {{ variant.options | json }},
        "price": {{ variant.price | money | json }},
        "available": {{ variant.available }},
        "url": {{ variant.url | json }},
        "plans": {
          {%- for alloc in variant.selling_plan_allocations -%}
            "{{ alloc.selling_plan.id }}": {{ alloc.price | money | json }}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    ]
  </script>
</section>

{%- comment -%} 関連商品（同じコレクションから） {%- endcomment -%}
{%- assign rel = product.collections.first -%}
{%- if rel != blank and rel.products.size > 1 -%}
  <section class="wrap fade" style="padding:0 0 clamp(56px,7vw,100px);">
    <div class="sec-head"><span class="eyebrow">{{ 'product.related' | t | default: 'こちらもおすすめ' }}</span></div>
    <div class="pgrid pgrid--scroll">
      {%- assign shown = 0 -%}
      {%- for p in rel.products -%}
        {%- if p.id != product.id and shown < 4 -%}
          {% render 'product-card', product: p %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{%- comment -%} モバイル固定購入バー {%- endcomment -%}
<div class="sticky-buy" data-sticky-buy aria-hidden="true">
  <div class="sticky-buy__info">
    <span class="sticky-buy__name">{{ product.title }}</span>
    <span class="sticky-buy__price" data-price-mirror>{{ v.price | money }}</span>
  </div>
  <button class="btn" type="button" data-sticky-add {% unless product.available %}disabled{% endunless %}>{{ 'product.add_to_cart' | t }}</button>
</div>

<!-- 構造化データ：商品（価格・在庫・パンくず） -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  {%- if product.description != blank -%}"description": {{ product.description | strip_html | truncate: 320 | json }},{%- endif -%}
  "image": [{%- for image in product.images -%}{{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
  "url": {{ canonical_url | json }},
  "offers": {
    {%- if product.variants.size > 1 -%}
    "@type": "AggregateOffer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "lowPrice": {{ product.price_min | money_without_currency | replace: ',', '' | json }},
    "highPrice": {{ product.price_max | money_without_currency | replace: ',', '' | json }},
    "offerCount": {{ product.variants.size }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
    {%- else -%}
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ v.price | money_without_currency | replace: ',', '' | json }},
    "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ canonical_url | json }}
    {%- endif -%}
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} },
    {%- if collection.url != blank -%}{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} },{%- endif -%}
    { "@type": "ListItem", "position": {% if collection.url != blank %}3{% else %}2{% endif %}, "name": {{ product.title | json }} }
  ]
}
</script>

{% schema %}
{ "name": "商品", "settings": [] }
{% endschema %}
