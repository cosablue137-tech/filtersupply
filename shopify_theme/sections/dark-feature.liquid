{%- comment -%} Filter Supply — subscription feature band (set on charcoal) {%- endcomment -%}
<section class="feature fade">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h2 class="feature__title display">{{ section.settings.heading }}</h2>
  {%- if section.settings.link_label != blank -%}
    <a class="ulink feature__sub-link" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "定期便セクション",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "ラベル", "default": "Subscription · 定期便" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "焙きたてを定期で" },
    { "type": "text", "id": "link_label", "label": "リンク文言", "default": "定期便のお申し込みはこちら" },
    { "type": "url", "id": "link_url", "label": "リンク先" }
  ],
  "presets": [{ "name": "定期便セクション" }]
}
{% endschema %}
