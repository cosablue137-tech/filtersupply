{%- comment -%} Filter Supply — wholesale page (split, dark text panel) {%- endcomment -%}
<section class="split">
  <div class="split__text">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading | newline_to_br }}</h2>
    {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    {%- if section.settings.for_list != blank -%}
      <div style="margin-top:30px;">
        <p class="eyebrow" style="color:rgba(255,255,255,.55);margin-bottom:10px;">For</p>
        <p style="font-family:var(--serif);font-size:1.15rem;line-height:1.7;color:rgba(255,255,255,.82);margin:0;">{{ section.settings.for_list | newline_to_br }}</p>
      </div>
    {%- endif -%}
    {%- if section.settings.btn_label != blank -%}<a class="ulink" style="color:#fff;margin-top:26px;" href="{{ section.settings.btn_link | default: '#' }}">{{ section.settings.btn_label }}</a>{%- endif -%}
  </div>
  <div class="split__media">
    {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "卸売（ホールセール）",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "ラベル", "default": "Wholesale" },
    { "type": "textarea", "id": "heading", "label": "見出し（改行可）", "default": "Coffee for\nYour Space." },
    { "type": "textarea", "id": "body", "label": "本文", "default": "カフェ、レストラン、ホテル、オフィスへ。焙煎豆と生豆の卸売を承ります。アチェ州とのダイレクトトレードによるロットもご用意し、一杯の価値を、空間とともにお届けします。" },
    { "type": "textarea", "id": "for_list", "label": "対象（改行可）", "default": "Cafés · Restaurants · Hotels\nLifestyle Stores · Roasters · Offices" },
    { "type": "text", "id": "btn_label", "label": "ボタン", "default": "Wholesale Inquiry" },
    { "type": "url", "id": "btn_link", "label": "リンク" },
    { "type": "image_picker", "id": "image", "label": "画像" }
  ],
  "presets": [{ "name": "卸売（ホールセール）" }]
}
{% endschema %}
