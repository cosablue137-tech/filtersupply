{%- comment -%} Filter Supply — hero (text column left + wide landscape photo right) {%- endcomment -%}
<section class="hero">
  <div class="hero__pane hero__pane--dark">
    {%- if section.settings.image_a != blank -%}
      <img
        src="{{ section.settings.image_a | image_url: width: 1400 }}"
        srcset="{{ section.settings.image_a | image_url: width: 800 }} 800w,
                {{ section.settings.image_a | image_url: width: 1400 }} 1400w,
                {{ section.settings.image_a | image_url: width: 2000 }} 2000w"
        sizes="(max-width: 640px) 100vw, 36vw"
        alt="{{ section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.image_a.width }}"
        height="{{ section.settings.image_a.height }}">
    {%- endif -%}
    <div class="hero__overlay">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.btn_label != blank -%}<a class="btn btn--light" href="{{ section.settings.btn_link | default: routes.all_products_collection_url }}">{{ section.settings.btn_label }}</a>{%- endif -%}
    </div>
  </div>
  <div class="hero__pane">
    {%- if section.settings.image_b != blank -%}
      <img
        src="{{ section.settings.image_b | image_url: width: 2000 }}"
        srcset="{{ section.settings.image_b | image_url: width: 1000 }} 1000w,
                {{ section.settings.image_b | image_url: width: 1600 }} 1600w,
                {{ section.settings.image_b | image_url: width: 2000 }} 2000w"
        sizes="(max-width: 640px) 100vw, 64vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.image_b.width }}"
        height="{{ section.settings.image_b.height }}">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ヒーロー",
  "settings": [
    { "type": "image_picker", "id": "image_a", "label": "左パネル画像" },
    { "type": "image_picker", "id": "image_b", "label": "右パネル画像（横長推奨）" },
    { "type": "text", "id": "eyebrow", "label": "ラベル", "default": "Fukuoka · Since 2019" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "A Cup of Time" },
    { "type": "text", "id": "btn_label", "label": "ボタン", "default": "Shop Now" },
    { "type": "url", "id": "btn_link", "label": "ボタン リンク" }
  ],
  "presets": [{ "name": "ヒーロー" }]
}
{% endschema %}
