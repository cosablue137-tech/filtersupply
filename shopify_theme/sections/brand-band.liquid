{%- comment -%} Filter Supply — brand band (cream) {%- endcomment -%}
<section class="band fade">
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="band__name">{{ section.settings.heading }}</h2>
  {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "ブランドバンド",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "ラベル", "default": "Fukuoka · Since 2019" },
    { "type": "text", "id": "heading", "label": "見出し（セリフ大）", "default": "コーヒーを通して、素晴らしい時間を。" },
    { "type": "textarea", "id": "body", "label": "本文", "default": "We source each bean for what it can become, and roast it to nothing less." }
  ],
  "presets": [{ "name": "ブランドバンド" }]
}
{% endschema %}
