{%- comment -%} Filter Supply — gift band {%- endcomment -%}
<section class="wband fade">
  <div class="wband__in">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="wband__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a class="btn" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
  {%- if section.settings.image != blank -%}
    <div class="wband__media"><img src="{{ section.settings.image | image_url: width: 1200 }}" alt="" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"></div>
  {%- else -%}
    <div class="wband__media wband__media--placeholder"></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "ギフトバナー",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "ラベル", "default": "Gift" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "大切な人へ、コーヒーを贈る。" },
    { "type": "text", "id": "link_label", "label": "ボタン文言", "default": "ギフトを見る" },
    { "type": "url", "id": "link_url", "label": "リンク先" },
    { "type": "image_picker", "id": "image", "label": "画像" }
  ],
  "presets": [{ "name": "ギフトバナー" }]
}
{% endschema %}
