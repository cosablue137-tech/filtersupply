{%- comment -%} Filter Supply — wholesale band {%- endcomment -%}
<section class="wband fade">
  <div class="wband__in">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="wband__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a class="ulink" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
  {%- if section.settings.image != blank -%}
    <div class="wband__media"><img src="{{ section.settings.image | image_url: width: 1200 }}" alt=""></div>
  {%- else -%}
    <div class="wband__media wband__media--placeholder"></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "卸売バナー",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "ラベル", "default": "Wholesale · 卸売" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "業務用のご案内" },
    { "type": "text", "id": "link_label", "label": "リンク文言", "default": "卸売のお問い合わせはこちら" },
    { "type": "url", "id": "link_url", "label": "リンク先" },
    { "type": "image_picker", "id": "image", "label": "画像" }
  ],
  "presets": [{ "name": "卸売バナー" }]
}
{% endschema %}
