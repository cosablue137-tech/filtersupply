{%- comment -%} Filter Supply — cart page (Beyond style table) {%- endcomment -%}
<main class="cart">
  <h1 class="cart__title">{{ 'cart.title_full' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div style="text-align:center;padding:40px 0 80px;">
      <p class="serif" style="font-size:1.6rem;margin:0 0 8px;">{{ 'cart.empty' | t }}</p>
      <p class="eyebrow" style="margin:0 0 28px;">Your cart is empty</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form">
      <div class="cart__table">
        <div class="cart__head"><span>{{ 'cart.product' | t }}</span><span>{{ 'cart.price' | t }}</span><span>{{ 'cart.quantity' | t }}</span><span>{{ 'cart.total' | t }}</span></div>

        {%- for item in cart.items -%}
          <div class="cline">
            <div class="cline__prod">
              <a class="cline__thumb" href="{{ item.url }}">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}">
                {%- else -%}<span style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-family:var(--jp);color:#cfcabf;">{{ item.product.metafields.custom.kanji | default: '豆' }}</span>{%- endif -%}
              </a>
              <div>
                <a href="{{ item.url }}"><div class="cline__name">{{ item.product.title }}</div></a>
                {%- unless item.variant.title contains 'Default' -%}<div class="eyebrow" style="margin-top:6px;">{{ item.variant.title }}</div>{%- endunless -%}
                {%- if item.product.metafields.custom.notes != blank -%}<div class="eyebrow" style="margin-top:6px;">{{ item.product.metafields.custom.notes }}</div>{%- endif -%}
              </div>
            </div>
            <div class="cline__price">{{ item.original_price | money }}</div>
            <div class="cline__qtywrap">
              <div class="qstep">
                <a href="{{ item.url_to_change }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | minus: 1 }}" aria-label="−">−</a>
                <input type="text" value="{{ item.quantity }}" readonly>
                <a href="{{ item.url_to_change }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | plus: 1 }}" aria-label="+">+</a>
              </div>
              <a class="cline__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>
            <div class="cline__total">{{ item.original_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart__foot">
        <div class="cart__note">
          <label for="order-note">{{ 'cart.note' | t }}</label>
          <textarea id="order-note" name="note" placeholder="{{ 'cart.note_ph' | t }}">{{ cart.note }}</textarea>
        </div>
        <div class="cart__sum">
          <span class="label label--mute">{{ 'cart.total' | t }}</span>
          <div class="cart__total">{{ cart.total_price | money }} {{ cart.currency.iso_code }}</div>
          <p class="cart__taxes">{{ 'cart.taxes_note' | t }}</p>
          <div class="cart__actions">
            <a class="ulink" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
            <button class="btn" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </div>
    </form>
  {%- endif -%}
</main>
