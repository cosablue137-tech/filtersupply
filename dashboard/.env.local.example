# Shopify ストアのドメイン（.myshopify.com まで含む）
SHOPIFY_STORE_DOMAIN=fve1vs-nz.myshopify.com

# dev dashboard 製アプリの Client ID / Secret（設定→資格情報からコピー）。
# サーバーが client_credentials grant で24時間トークンを自動取得・更新する。
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# （旧方式の静的トークンを使う場合のみ。通常は空でよい）
# SHOPIFY_ADMIN_TOKEN=

# ダッシュボードを開くための合い言葉（チームで共有）
DASHBOARD_PASSWORD=change-me

# ログインCookieの署名に使うランダム文字列（例: openssl rand -hex 32 で生成）
DASHBOARD_SESSION_SECRET=change-me-to-a-long-random-string

# ── Instagram 分析（任意・未設定なら Instagram タブはエラー表示）──
# Instagram Graph API のアクセストークン（長期 or システムユーザー）
IG_ACCESS_TOKEN=
# IG ビジネスアカウントID（数値。/me/accounts → page → instagram_business_account で取得）
IG_BUSINESS_ACCOUNT_ID=
# 競合ベンチマーク対象のユーザー名（@なし・カンマ区切り・任意）
IG_COMPETITORS=coffeecountycc
