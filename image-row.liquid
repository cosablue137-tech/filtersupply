{%- comment -%} Filter Supply — image row (lifestyle tiles) {%- endcomment -%}
<section class="irow">
  {%- for block in section.blocks -%}
    <a class="irow__cell" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 700 }}" alt="">{%- endif -%}
      <div class="irow__label">{{ block.settings.label }}{% if block.settings.sub != blank %}<small>{{ block.settings.sub }}</small>{% endif %}</div>
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "画像の行",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tile", "name": "タイル",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "画像" },
        { "type": "text", "id": "label", "label": "ラベル", "default": "Single Origin" },
        { "type": "text", "id": "sub", "label": "サブ", "default": "シングルオリジン" },
        { "type": "url", "id": "link", "label": "リンク" }
      ]
    }
  ],
  "presets": [{
    "name": "画像の行",
    "blocks": [
      { "type": "tile", "settings": { "label": "Single Origin", "sub": "シングルオリジン" } },
      { "type": "tile", "settings": { "label": "Blends", "sub": "ブレンド" } },
      { "type": "tile", "settings": { "label": "Drip Bags", "sub": "ドリップバッグ" } },
      { "type": "tile", "settings": { "label": "Equipment", "sub": "器具" } }
    ]
  }]
}
{% endschema %}
