{%- comment -%}
  Filter Supply — product page.
  Optional metafields: custom.notes, custom.origin, custom.process,
  custom.roast, custom.weight, custom.brew, custom.kanji (all text).
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.custom
  assign v = product.selected_or_first_available_variant
-%}
<section class="wrap" style="padding:clamp(28px,4vw,56px) 0 clamp(56px,7vw,100px);">
  <a class="ulink" href="{{ collection.url | default: routes.all_products_collection_url }}" style="display:inline-block;margin-bottom:clamp(24px,3vw,44px);">← {{ 'product.back' | t }}</a>

  <div class="fprod" style="padding:0;">
    <div class="fprod__media">
      <div class="fprod__thumbs">
        {%- for image in product.images limit: 3 -%}
          <div class="fprod__thumb"><img src="{{ image | image_url: width: 240 }}" alt=""></div>
        {%- endfor -%}
      </div>
      <div class="fprod__main">
        {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
        {%- else -%}<span style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-family:var(--jp);font-size:80px;color:#e4e0d8;">{{ m.kanji | default: '豆' }}</span>{%- endif -%}
      </div>
    </div>

    <div class="fprod__info">
      {%- if m.origin != blank -%}<span class="eyebrow">{{ m.origin }}</span>{%- endif -%}
      <h2>{{ product.title }}</h2>
      {%- if m.notes != blank -%}<p class="eyebrow" style="margin:-6px 0 14px;color:var(--muted);">{{ m.notes }}</p>{%- endif -%}
      <p class="fprod__price" data-price>{{ v.price | money }}</p>

      {% form 'product', product, data-product-form: 'true' %}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div style="margin-bottom:18px;" data-option-index="{{ forloop.index0 }}">
              <div class="eyebrow" style="margin-bottom:10px;">{{ option.name }}</div>
              <div style="display:flex;gap:10px;flex-wrap:wrap;">
                {%- for value in option.values -%}
                  <button type="button" class="sf-chip{% if option.selected_value == value %} is-active{% endif %}" data-value="{{ value | escape }}"
                    style="font-family:var(--sans);font-size:11px;letter-spacing:var(--track-sm);text-transform:uppercase;padding:10px 16px;border:1px solid {% if option.selected_value == value %}var(--ink){% else %}var(--line-2){% endif %};background:{% if option.selected_value == value %}var(--ink){% else %}transparent{% endif %};color:{% if option.selected_value == value %}#fff{% else %}var(--ink){% endif %};">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ v.id }}">

        <div class="fprod__buy" style="margin-top:24px;">
          <div style="display:flex;gap:12px;">
            <div class="qstep" data-stepper>
              <button type="button" data-step="-1" aria-label="−">−</button>
              <input type="text" name="quantity" value="1" readonly>
              <button type="button" data-step="1" aria-label="+">+</button>
            </div>
            <button class="btn btn--block" type="submit" {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
            </button>
          </div>
          {%- if product.available -%}<button class="btn btn--ghost btn--block" type="submit" name="checkout">{{ 'product.buy_now' | t }}</button>{%- endif -%}
        </div>
      {% endform %}

      <div class="fprod__acc">
        {%- if product.description != blank -%}
          <details class="acc-item" open><summary>{{ 'product.description' | t }} <span class="pm">+</span></summary><div class="acc-item__body">{{ product.description }}</div></details>
        {%- endif -%}
        {%- if m.origin != blank or m.process != blank or m.roast != blank or m.weight != blank -%}
          <details class="acc-item"><summary>{{ 'product.details' | t }} <span class="pm">+</span></summary><div class="acc-item__body">
            {%- if m.origin != blank -%}原産地：{{ m.origin }}<br>{%- endif -%}
            {%- if m.process != blank -%}精製：{{ m.process }}<br>{%- endif -%}
            {%- if m.roast != blank -%}焙煎度：{{ m.roast }}<br>{%- endif -%}
            {%- if m.weight != blank -%}内容量：{{ m.weight }}{%- endif -%}
          </div></details>
        {%- endif -%}
        {%- if m.brew != blank -%}
          <details class="acc-item"><summary>{{ 'product.brewing' | t }} <span class="pm">+</span></summary><div class="acc-item__body">{{ m.brew }}</div></details>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" id="fs-variants-json">{{ product.variants | json }}</script>
</section>

{% schema %}
{ "name": "商品", "settings": [] }
{% endschema %}
