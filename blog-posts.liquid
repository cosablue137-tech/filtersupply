{%- comment -%} Filter Supply — blog posts {%- endcomment -%}
{%- liquid
  assign blog = blogs[section.settings.blog]
-%}
<section class="wrap" style="padding:clamp(56px,7vw,100px) 0;">
  <div class="sec-head"><h2 class="sec-title">{{ section.settings.heading | default: 'From the Journal' }}</h2></div>
  <div class="blog__grid">
    {%- if blog != blank and blog.articles_count > 0 -%}
      {%- for article in blog.articles limit: 3 -%}
        <article class="bpost">
          <a class="bpost__media" href="{{ article.url }}">
            {%- if article.image -%}<img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" loading="lazy">{%- endif -%}
          </a>
          <h3 class="bpost__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <p class="bpost__date">{{ article.published_at | date: '%Y.%m.%d' }}</p>
          <a class="ulink" href="{{ article.url }}">Continue Reading</a>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <article class="bpost"><div class="bpost__media"></div><h3 class="bpost__title">記事タイトル</h3><p class="bpost__date">2026.01.01</p><a class="ulink" href="#">Continue Reading</a></article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ジャーナル",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "From the Journal" },
    { "type": "blog", "id": "blog", "label": "ブログ" }
  ],
  "presets": [{ "name": "ジャーナル" }]
}
{% endschema %}
