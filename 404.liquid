{%- comment -%} Filter Supply — 404 {%- endcomment -%}
<main class="wrap" style="min-height:54vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:80px 0;">
  <h1 class="h-serif" style="font-size:clamp(2rem,3.4vw,2.8rem);">{{ 'error.404_title' | t }}</h1>
  <p style="font-family:var(--jp);font-weight:300;color:var(--ink-60);margin:14px 0 30px;">{{ 'error.404_body' | t }}</p>
  <a class="btn" href="{{ routes.root_url }}">{{ 'error.home' | t }}</a>
</main>
